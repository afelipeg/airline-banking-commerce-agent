# Copy to .env and add your key. The API (airline/api/main.py) reads it through
# demo_common.load_demo_env. Never commit a real key.
ANTHROPIC_API_KEY=
# 0 lets a chat approval apply a merchant change; the default requires the portal's Approve button.
# MERCHANT_REQUIRE_HOST_APPROVAL=1

# Optional Jev (typesafe.ai) credit judgments; needs `pip install -r requirements-jev.txt`.
# Without both lines the deterministic scorecard decides.
# QUASAR_CREDIT_ENGINE=jev
# TYPESAFE_API_KEY=
# QUASAR_JEV_MODEL=jev-latest
